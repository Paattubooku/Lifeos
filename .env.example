# Copy to .env and fill in from Supabase → Project Settings → API.
# Only the anon/publishable key goes in the app. Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Dev builds only: set to 1 to show "Create account (dev)" on the sign-in screen
# (needs sign-ups enabled in Supabase → Authentication → Sign In / Providers).
# Leave unset for normal use: LifeOS has a single account and no sign-up screen.
EXPO_PUBLIC_ENABLE_SIGNUP=
